<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>David's eBikes</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet">
<style>
/* ===== COLOUR SCHEMES — pick one, delete the switcher when done ===== */
:root, [data-theme="volt"] {
  --bg:#0f1115; --surface:#181b22; --text:#eef1f5; --muted:#9aa3b2;
  --accent:#c6ff3d; --accent-ink:#0f1115; --line:#262a33; --header:#0a0b0e;
}
[data-theme="eco"] {
  --bg:#f6f8f5; --surface:#ffffff; --text:#14231c; --muted:#5d6e66;
  --accent:#0f9d74; --accent-ink:#ffffff; --line:#dfe6e1; --header:#0e2a20;
}
[data-theme="copper"] {
  --bg:#f4f1ec; --surface:#ffffff; --text:#1d1d1f; --muted:#6b6862;
  --accent:#d0652a; --accent-ink:#ffffff; --line:#e3ddd3; --header:#1d1d1f;
}
* { box-sizing:border-box; margin:0; }
body { font-family:Inter,system-ui,sans-serif; background:var(--bg); color:var(--text); line-height:1.5; transition:background .3s,color .3s; }
a { color:inherit; text-decoration:none; }
.wrap { max-width:1140px; margin:0 auto; padding:0 16px; }

/* Header */
header { background:var(--header); color:#fff; position:sticky; top:0; z-index:10; }
header .wrap { display:flex; align-items:center; justify-content:space-between; height:68px; gap:16px; }
.logo { font-weight:800; font-size:20px; letter-spacing:-.02em; }
.logo span { color:var(--accent); }
nav { display:flex; gap:24px; font-size:15px; }
nav a { opacity:.85; } nav a:hover { opacity:1; color:var(--accent); }
.cart { background:var(--accent); color:var(--accent-ink); padding:8px 14px; border-radius:999px; font-weight:600; font-size:14px; }
@media (max-width:760px){ nav { display:none; } }

/* Hero */
.hero { padding:64px 0 48px; }
.hero h1 { font-size:clamp(32px,6vw,56px); line-height:1.05; letter-spacing:-.03em; font-weight:800; max-width:14ch; }
.hero h1 em { font-style:normal; color:var(--accent); }
.hero p { color:var(--muted); font-size:18px; margin:16px 0 28px; max-width:46ch; }
.btn { display:inline-block; background:var(--accent); color:var(--accent-ink); padding:14px 24px; border-radius:10px; font-weight:600; border:0; cursor:pointer; font:inherit; font-weight:600; }
.btn.ghost { background:transparent; color:var(--text); border:1px solid var(--line); margin-left:8px; }

/* Perks */
.perks { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:12px; margin-bottom:48px; }
.perk { background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:16px; font-size:14px; }
.perk b { display:block; font-size:15px; margin-bottom:2px; }

/* Shop */
.shop-bar { display:flex; flex-wrap:wrap; gap:12px; align-items:center; justify-content:space-between; margin-bottom:20px; }
.shop-bar h2 { font-size:28px; letter-spacing:-.02em; }
.filters { display:flex; flex-wrap:wrap; gap:8px; }
.chip { background:var(--surface); border:1px solid var(--line); color:var(--text); padding:7px 14px; border-radius:999px; cursor:pointer; font:inherit; font-size:14px; }
.chip.on { background:var(--accent); color:var(--accent-ink); border-color:var(--accent); }
select { background:var(--surface); color:var(--text); border:1px solid var(--line); border-radius:8px; padding:8px 10px; font:inherit; font-size:14px; }
.grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:20px; margin-bottom:64px; }
.card { background:var(--surface); border:1px solid var(--line); border-radius:14px; overflow:hidden; display:flex; flex-direction:column; transition:transform .2s; }
.card:hover { transform:translateY(-3px); }
.img { aspect-ratio:4/3; display:grid; place-items:center; background:linear-gradient(160deg,var(--bg),var(--surface)); color:var(--text); position:relative; }
.img svg { width:78%; }
.tag { position:absolute; top:12px; left:12px; background:var(--accent); color:var(--accent-ink); font-size:12px; font-weight:600; padding:3px 9px; border-radius:6px; }
.body { padding:16px; display:flex; flex-direction:column; gap:6px; flex:1; }
.body h3 { font-size:17px; }
.specs { color:var(--muted); font-size:13px; }
.row { display:flex; justify-content:space-between; align-items:center; margin-top:auto; padding-top:10px; }
.price { font-size:20px; font-weight:800; }
.price s { font-size:14px; color:var(--muted); font-weight:400; margin-left:6px; }
.add { background:transparent; border:1px solid var(--accent); color:var(--text); padding:7px 12px; border-radius:8px; cursor:pointer; font:inherit; font-size:14px; }
.add:hover { background:var(--accent); color:var(--accent-ink); }

footer { background:var(--header); color:#cfd3da; padding:40px 0; font-size:14px; }
footer .wrap { display:flex; flex-wrap:wrap; justify-content:space-between; gap:16px; }

/* Preview-only theme switcher */
.switcher { position:fixed; bottom:16px; right:16px; background:#fff; color:#111; border-radius:12px; padding:10px; box-shadow:0 8px 30px rgba(0,0,0,.25); z-index:20; font-size:13px; }
.switcher b { display:block; margin-bottom:6px; }
.switcher button { display:flex; align-items:center; gap:8px; width:100%; background:none; border:1px solid transparent; border-radius:8px; padding:6px 8px; cursor:pointer; font:inherit; text-align:left; }
.switcher button.on { border-color:#111; }
.sw { display:flex; } .sw i { width:14px; height:14px; border-radius:50%; margin-right:-3px; border:1px solid #0002; }
</style>
</head>
<body data-theme="volt">

<!-- Reusable bike illustration (placeholder until real photos are added) -->
<svg width="0" height="0" style="position:absolute">
  <symbol id="bike" viewBox="0 0 240 150">
    <g fill="none" stroke="currentColor" stroke-width="10"><circle cx="55" cy="100" r="38"/><circle cx="185" cy="100" r="38"/></g>
    <g fill="none" stroke="var(--accent)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M55 100 L100 100 L150 50 L95 50 Z"/><path d="M100 100 L85 40"/><path d="M150 50 L185 100"/><path d="M145 25 L150 50"/>
    </g>
    <rect x="104" y="58" width="30" height="14" rx="4" transform="rotate(-45 119 65)" fill="currentColor"/>
    <g stroke="currentColor" stroke-width="6" stroke-linecap="round"><path d="M72 38 L98 38"/><path d="M135 25 L160 22"/></g>
    <circle cx="100" cy="100" r="8" fill="currentColor"/>
  </symbol>
</svg>

<header>
  <div class="wrap">
    <a class="logo" href="#">David's <span>eBikes</span></a>
    <nav><a href="#">Home</a><a href="#shop">Shop</a><a href="#">Service</a><a href="#">About</a><a href="#">Contact</a></nav>
    <a class="cart" href="#">Cart (<span id="count">0</span>)</a>
  </div>
</header>

<main class="wrap">
  <section class="hero">
    <h1>Ride further. <em>Sweat less.</em></h1>
    <p>Fat-tyre, folding and commuter e-bikes, shipped Australia-wide with a 2-year warranty.</p>
    <a class="btn" href="#shop">Shop e-bikes</a><a class="btn ghost" href="#">Book a test ride</a>
  </section>

  <section class="perks">
    <div class="perk"><b>Free delivery</b>Australia-wide, arrives 95% assembled</div>
    <div class="perk"><b>2-year warranty</b>Motor, battery and frame</div>
    <div class="perk"><b>Local servicing</b>Brisbane workshop</div>
    <div class="perk"><b>Pay later</b>Afterpay &amp; Zip available</div>
  </section>

  <section id="shop">
    <div class="shop-bar">
      <h2>Electric bikes</h2>
      <div class="filters" id="filters"></div>
      <select id="sort">
        <option value="pop">Sort: Popular</option>
        <option value="low">Price: low to high</option>
        <option value="high">Price: high to low</option>
      </select>
    </div>
    <div class="grid" id="grid"></div>
  </section>
</main>

<footer>
  <div class="wrap">
    <div><b style="color:#fff">David's eBikes</b><br>Brisbane, QLD</div>
    <div>Shipping · Returns · Warranty · FAQ</div>
    <div>© 2026 David's eBikes</div>
  </div>
</footer>

<div class="switcher" id="switcher"><b>Colour scheme (preview)</b></div>

<script>
// ===== PRODUCTS — edit this list to add/change bikes =====
const products = [
  { name:"Trailblazer Fat 20", cat:"Folding", price:1499, was:1799, specs:"500W · 48V 15Ah · 20\" fat tyre · Shimano 7-speed", tag:"Sale" },
  { name:"Foldaway Compact",   cat:"Folding", price:1299, specs:"500W · 48V 13Ah · 20\" fat tyre · Alloy frame" },
  { name:"Summit 26 Full-Sus", cat:"Mountain", price:1899, specs:"500W · 48V 15Ah · 26\" fat tyre · Dual disc", tag:"Popular" },
  { name:"City Glide",         cat:"Commuter", price:1599, specs:"250W · 36V 14Ah · 700c · Integrated lights" },
  { name:"Cargo Hauler",       cat:"Cargo",    price:2799, specs:"750W · 48V 20Ah · 150kg payload · Rear rack" },
  { name:"Ridge Pro 29",       cat:"Mountain", price:2399, specs:"750W mid-drive · 48V 17.5Ah · Hydraulic brakes", tag:"New" },
];

const themes = [
  { id:"volt",   name:"Volt — bold & sporty",   sw:["#0f1115","#c6ff3d","#eef1f5"] },
  { id:"eco",    name:"Eco — clean & green",    sw:["#0e2a20","#0f9d74","#f6f8f5"] },
  { id:"copper", name:"Copper — premium",       sw:["#1d1d1f","#d0652a","#f4f1ec"] },
];

let cat = "All", sort = "pop", count = 0;
const grid = document.getElementById("grid");

function render() {
  let list = products.filter(p => cat === "All" || p.cat === cat);
  if (sort === "low")  list = [...list].sort((a,b) => a.price - b.price);
  if (sort === "high") list = [...list].sort((a,b) => b.price - a.price);
  grid.innerHTML = list.map(p => `
    <article class="card">
      <div class="img">${p.tag ? `<span class="tag">${p.tag}</span>` : ""}<svg><use href="#bike"/></svg></div>
      <div class="body">
        <h3>${p.name}</h3>
        <div class="specs">${p.specs}</div>
        <div class="row">
          <div class="price">$${p.price.toLocaleString()}${p.was ? `<s>$${p.was.toLocaleString()}</s>` : ""}</div>
          <button class="add">Add to cart</button>
        </div>
      </div>
    </article>`).join("");
  grid.querySelectorAll(".add").forEach(b => b.onclick = () => document.getElementById("count").textContent = ++count);
}

const cats = ["All", ...new Set(products.map(p => p.cat))];
const filters = document.getElementById("filters");
filters.innerHTML = cats.map(c => `<button class="chip${c==="All"?" on":""}">${c}</button>`).join("");
filters.querySelectorAll(".chip").forEach(b => b.onclick = () => {
  filters.querySelectorAll(".chip").forEach(x => x.classList.remove("on"));
  b.classList.add("on"); cat = b.textContent; render();
});
document.getElementById("sort").onchange = e => { sort = e.target.value; render(); };

const sw = document.getElementById("switcher");
themes.forEach((t,i) => {
  const b = document.createElement("button");
  b.className = i === 0 ? "on" : "";
  b.innerHTML = `<span class="sw">${t.sw.map(c=>`<i style="background:${c}"></i>`).join("")}</span>${t.name}`;
  b.onclick = () => { document.body.dataset.theme = t.id; sw.querySelectorAll("button").forEach(x=>x.classList.remove("on")); b.classList.add("on"); };
  sw.appendChild(b);
});

render();
</script>
</body>
</html>
